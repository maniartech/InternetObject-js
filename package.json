{
  "name": "internet-object",
  "version": "0.3.0",
  "description": "Internet Object: a schema-first data format with JSON's data model and about half the bytes for a collection. Parse, validate, serialize and stream -- typed errors with positions, zero dependencies, TypeScript-first.",
  "keywords": [
    "internet-object",
    "io",
    "data-format",
    "data-interchange",
    "serialization",
    "wire-format",
    "json",
    "json-alternative",
    "json-schema",
    "yaml",
    "csv",
    "protobuf",
    "messagepack",
    "schema",
    "schema-validation",
    "validation",
    "type-safe",
    "typed",
    "parser",
    "serializer",
    "stringify",
    "streaming",
    "ndjson",
    "stream-parser",
    "api",
    "rest",
    "http",
    "payload",
    "compact",
    "human-readable",
    "config",
    "decimal",
    "bigint",
    "datetime",
    "base64",
    "typescript",
    "nodejs",
    "browser",
    "esm",
    "cjs",
    "zero-dependencies"
  ],
  "author": {
    "name": "Mohamed Aamir Maniar",
    "email": "contact@maniartech.com",
    "url": "https://maniartech.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://internetobject.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/maniartech/InternetObject-js.git"
  },
  "bugs": {
    "url": "https://github.com/maniartech/InternetObject-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/schema/types/index.js",
    "./dist/schema/types/index.cjs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:streaming": "vitest run tests/streaming src/streaming/conformance.test.ts tests/parser/tokenizer/features/stream-tokenizer.test.ts tests/parser/ast-parser/parse-section.test.ts",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist coverage",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting placeholder - add Biome later'",
    "precommit": "yarn lint && yarn type-check && yarn test",
    "prepublishOnly": "yarn clean && yarn build && yarn test",
    "perf": "tsx tests/performance/performance.ts",
    "perf:decimal": "tsx tests/performance/performance.decimal.ts",
    "stream:server:http": "tsx src/streaming/examples/node-http-server.ts",
    "stream:client:http": "tsx src/streaming/examples/node-http-client.ts",
    "check-release": "bash scripts/pre-publish-check.sh",
    "bundle:analyze": "bash scripts/bundle-analyze.sh",
    "bundle:test-minimal": "bash scripts/bundle-test-minimal.sh",
    "bundle:test-full": "bash scripts/bundle-test-full.sh",
    "bundle:compare": "bash scripts/bundle-compare.sh",
    "bundle:budget-check": "bash scripts/bundle-budget-check.sh",
    "corpus": "tsx tools/corpus/verify.ts",
    "corpus:bootstrap": "tsx tools/corpus/bootstrap-csv.ts",
    "corpus:both": "tsx tools/corpus/verify-both.ts",
    "corpus:tokens": "tsx tools/corpus/verify-bootstrap.ts",
    "fuzz:triage": "tsx tools/fuzz/triage.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "chalk": "^5.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vitest": "^1.6.1"
  },
  "resolutions": {
    "esbuild": "^0.25.0"
  }
}
